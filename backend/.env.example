# Cerebro configuration — EXAMPLE
#
# You do not need this file. Cerebro runs with every default below already
# applied, and the setup wizard at http://localhost:8000/setup writes a real
# .env for you.
#
# To configure by hand instead:  cp .env.example .env  and uncomment what you
# want to change. Anything left commented keeps its built-in default.

# --- General -------------------------------------------------
# APP_NAME=Cerebro
# HOST=127.0.0.1
# PORT=8000
# ENVIRONMENT=development
# DEBUG=false
# CORS_ORIGINS=*

# --- Database ------------------------------------------------
# Defaults to a SQLite file at <project>/data/cerebro.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cerebro
# SQLALCHEMY_ECHO=false

# --- AI Provider ---------------------------------------------
# none | openai | ollama | qwen | bedrock
# LLM_PROVIDER=none
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# OPENAI_ORG_ID=
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# QWEN_API_URL=
# QWEN_API_KEY=
# QWEN_MODEL=qwen-plus
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=
# default | profile | keys
# BEDROCK_AUTH_MODE=default
# BEDROCK_AWS_PROFILE=
# BEDROCK_AWS_ACCESS_KEY_ID=
# BEDROCK_AWS_SECRET_ACCESS_KEY=
# BEDROCK_AWS_SESSION_TOKEN=
# BEDROCK_ENDPOINT_URL=
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=500
# LLM_TIMEOUT=60

# --- Knowledge Search ----------------------------------------
# auto | local | qdrant   (auto = Qdrant if reachable, else built-in)
# VECTOR_BACKEND=auto
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# local | openai
# EMBEDDING_PROVIDER=local
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Desktop Capture -----------------------------------------
# SCREENPIPE_ENABLED=true
# SCREENPIPE_URL=http://localhost:3030

# --- Logging -------------------------------------------------
# DEBUG | INFO | WARN | ERROR
# LOG_LEVEL=INFO
# CEREBRO_LOG_PATH=
# LOG_TO_STDOUT=true
